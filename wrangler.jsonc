{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfmc-custom-jb-invoke-flow",
  "main": "deployment/cloudflare/worker.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/config.json", "/health", "/activity/*"]
  }
}
