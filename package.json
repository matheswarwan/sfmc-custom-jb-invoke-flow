{
  "name": "journey-action-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @jah/shared && npm run build -w @jah/api && npm run build -w @jah/web && tsc -p deployment/cloudflare/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "dev": "npm run dev -w @jah/web",
    "start": "npm run start -w @jah/api",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.1"
  }
}
